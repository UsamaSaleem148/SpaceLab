# Required for production builds: the public HTTPS origin SpaceLab is served from,
# e.g. SITE_URL=https://spacelab.your-domain.com
# Used at build time only for the canonical URL, og:url, absolute Open Graph /
# Twitter image URLs, JSON-LD url and sitemap.xml. If unset, those are omitted
# (the build warns) rather than pointing at a guessed domain.
SITE_URL=

# Copy to .env.local and fill in. Get a token at https://ion.cesium.com/tokens
# Without it, SpaceLab falls back to Cesium's bundled low-resolution imagery.
VITE_CESIUM_ION_TOKEN=

# Optional: night-side city lights in Terrain View. Add "Earth at Night" from the
# ion Asset Depot to your account first, then set its asset ID (normally 3812).
VITE_CESIUM_NIGHT_ASSET_ID=
